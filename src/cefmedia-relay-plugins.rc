// cefmedia-relay-plugins.rc — DLL version resource.
// Version is hand-synced with data/manifest.json ("version") — bump both
// together when the version changes.
#include <winres.h>

#define CEFMEDIA_VERSION_MAJOR 1
#define CEFMEDIA_VERSION_MINOR 0
#define CEFMEDIA_VERSION_PATCH 0
#define CEFMEDIA_VERSION_BUILD 0
// The version STRING is hand-written (not macro-assembled): rc.exe's nested
// stringify handling is unreliable (raw macro names have been observed leaking
// into FileVersion). Bump together with the numbers above.
#define CEFMEDIA_VERSION_STRING "1.0.0.0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION CEFMEDIA_VERSION_MAJOR,CEFMEDIA_VERSION_MINOR,CEFMEDIA_VERSION_PATCH,CEFMEDIA_VERSION_BUILD
 PRODUCTVERSION CEFMEDIA_VERSION_MAJOR,CEFMEDIA_VERSION_MINOR,CEFMEDIA_VERSION_PATCH,CEFMEDIA_VERSION_BUILD
 FILEFLAGSMASK 0x17L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "CefMedia Labs"
            VALUE "FileDescription", "cefmedia-relay-plugins"
            VALUE "FileVersion", CEFMEDIA_VERSION_STRING
            VALUE "InternalName", "cefmedia-relay-plugins"
            VALUE "LegalCopyright", "Copyright (C) 2026 CefMedia Labs. Licensed under GPL-2.0."
            VALUE "OriginalFilename", "cefmedia-relay-plugins.dll"
            VALUE "ProductName", "CefMedia Relay Plugins"
            VALUE "ProductVersion", CEFMEDIA_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
